APP_ENV=prod
API_HOST=0.0.0.0
API_PORT=18000

OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=
OPENCLAW_TIMEOUT_SECONDS=5

# Legacy token import only: ./manage local|prod tokens import-legacy --name NAME
# Runtime API authentication uses the api_tokens database table.
API_TOKEN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=website_checker
DB_USER=root
DB_PASS=

# Independent worker
OPENCLAW_AGENT_ID=website-checker-agent
OPENCLAW_MODEL=openai/gpt-6-astra
OPENCLAW_THINKING=low
WORKER_REQUEST_TIMEOUT_SECONDS=900
WORKER_POLL_SECONDS=3
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_SECONDS=120

# Enable only after applying sql/008_discussion_notifications.sql in this environment.
DISCUSSION_NOTIFICATIONS_ENABLED=false
DISCUSSION_API_TOKEN=

# cPanel retry modal entry; configure separately for each environment.
AUDIT_RETRY_PAGE_URL=https://yifantest.newpages.com.my/admin/website_checker/
